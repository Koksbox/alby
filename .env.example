# Copy this file to .env. Actual secrets are ignored by Git.
# Existing login/password/role behavior remains unchanged.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here
# Leave empty to keep SQLite. Docker uses /app/data/db.sqlite3.
DATABASE_URL=

# Start the worker only after migrations and configuration. No copy runs in web requests.
BACKUP_ENABLED=0
BACKUP_YANDEX_ENABLED=1
# Sum of days and hours. Normal: 3 + 0; test: 0 + 1 (every hour).
# Fractional hours are supported: 0.016667 is approximately one minute.
BACKUP_INTERVAL_DAYS=3
BACKUP_INTERVAL_HOURS=0
BACKUP_RETRY_SECONDS=300
BACKUP_POLL_SECONDS=30
# PostgreSQL only: path to a pg_dump client compatible with the server.
BACKUP_PG_DUMP_BINARY=pg_dump
# Relative to the project's working directory, shared by web and worker.
# Absolute paths outside media/static may also be used.
BACKUP_STAGING_ROOT=var/backup-staging
BACKUP_LOCAL_ROOT=var/backup-store

# Generate once and preserve separately for recovery:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=
# OAuth application credentials. Do not commit them.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/director/backups/yandex/callback/
YANDEX_OAUTH_SCOPE=cloud_api:disk.app_folder
YANDEX_BACKUP_ROOT=app:/AlbyBackups
# Direct token configuration works without adding any frontend controls.
YANDEX_ACCESS_TOKEN=
YANDEX_REFRESH_TOKEN=
